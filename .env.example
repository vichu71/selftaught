# Copia este fichero a .env y rellénalo. El .env real NO se sube al repositorio.
# Si falta una variable obligatoria, Compose no arranca (nunca hay valores por defecto inseguros).

# --- Base de datos (tres contraseñas distintas) ---
POSTGRES_PASSWORD=
DB_OWNER_PASSWORD=
SPRING_DATASOURCE_PASSWORD=

# --- Aplicación ---
# URL pública desde la que se abre la web; se usa en los enlaces de los correos
APP_PUBLIC_URL=http://127.0.0.1:8080

# --- Correo ---
# En desarrollo (make up) los correos van a Mailpit (http://127.0.0.1:8025) y estas credenciales se ignoran.
# En producción el correo es obligatorio. Con Gmail: puerto 587 y una contraseña de aplicación.
MAIL_ENABLED=true
MAIL_FROM=
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=

# --- IA (F02) ---
# En desarrollo (make up) todas las tareas usan el proveedor falso: no hace falta ninguna clave ni se gasta nada.
# Para usar modelos reales, indica por tarea el proveedor (anthropic, openai, gemini; ollama para EMBEDDING) y el modelo, y la clave del
# proveedor que uses. Cada modelo necesita su precio en backend/src/main/resources/ai-pricing.properties.
# Tareas: OUTLINE (ficha y temario), LESSON, ASSESSMENT (ejercicios y exámenes), TUTOR, EMBEDDING.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# Ollama: por defecto el contenedor del proyecto (la misma imagen vale en producción)
OLLAMA_BASE_URL=http://ollama:11434
# Tope mensual en USD (obligatorio con un proveedor real). WARN avisa al 80 % y al 100 % y sigue; BLOCK además rechaza llamadas.
AI_MONTHLY_LIMIT_USD=
AI_BUDGET_MODE=WARN
# Tope personal por usuario y mes, en USD. Corta siempre (también en WARN): un menor no puede gastar todo el presupuesto.
AI_USER_LIMIT_MINOR_USD=2.00
AI_USER_LIMIT_ADULT_USD=10.00
# Propietario (F14): el correo de la cuenta adulta (verificada) que ve el panel de administración /propietario. Opcional y sin valor por
# defecto: vacío = no hay propietario ni panel. Cambiarlo exige reiniciar el backend. Antes de abrir la app a Internet: HTTPS y cookie Secure.
OWNER_EMAIL=
# Material propio (F03): tamaño máximo por fichero y documentos por usuario. Si subes el tamaño, sube también
# client_max_body_size de /api/material en frontend/nginx.conf (hoy 11m).
MATERIAL_MAX_FILE_MB=10
MATERIAL_MAX_DOCUMENTS=20
# F19: fotos de apuntes. Opcional: sin APP_AI_TASKS_OCR_* las fotos quedan desactivadas. Solo sirven proveedores que ven imágenes (openai, gemini) y el modelo
# necesita su precio por tokens en ai-pricing.properties. Cada foto la lee un servicio de IA de pago.
MATERIAL_MAX_IMAGE_MB=5
MATERIAL_MAX_IMAGE_READS_PER_DAY=20
# APP_AI_TASKS_OCR_PROVIDER=
# APP_AI_TASKS_OCR_MODEL=
# Asistente de creación de curso (F04), por usuario: consultas por hora y cursos pendientes de generar
COURSE_INTAKES_PER_HOUR=30
COURSE_MAX_PENDING=5
# APP_AI_TASKS_OUTLINE_PROVIDER=
# APP_AI_TASKS_OUTLINE_MODEL=
# (igual para LESSON, ASSESSMENT, TUTOR, EMBEDDING e INTAKE; INTAKE, el asistente de F04, solo necesita un modelo rápido y barato)
# APP_AI_TASKS_INTAKE_PROVIDER=
# APP_AI_TASKS_INTAKE_MODEL=

# Benchmark (make benchmark): modelos a comparar, "proveedor/modelo" separados por comas, y tope de gasto del run en USD
# APP_AI_BENCHMARK_MODELS=
# APP_AI_BENCHMARK_BUDGET_USD=5.00

# Ilustraciones de portada (F12), opcionales: sin proveedor y modelo de imagen la opción «Con ilustraciones» no aparece y la app funciona igual.
# Proveedores que dibujan: openai y gemini (usan las mismas claves de arriba). El modelo necesita su precio por imagen en ai-pricing.properties.
# APP_AI_TASKS_IMAGE_PROVIDER=
# APP_AI_TASKS_IMAGE_MODEL=
# Benchmark de imágenes (make benchmark-images): gasta dinero real. Modelos "proveedor/modelo" separados por comas y tope del run en USD
# APP_AI_BENCHMARK_IMAGE_MODELS=
# APP_AI_BENCHMARK_IMAGE_BUDGET_USD=2.00
